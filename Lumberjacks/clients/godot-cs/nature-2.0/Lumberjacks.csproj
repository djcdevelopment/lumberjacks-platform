<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>CommunitySurvival</RootNamespace>
    <AssemblyName>Lumberjacks</AssemblyName>
    <!-- Godot invokes dotnet publish itself. Serial project-reference builds avoid two target
         graph legs racing on the shared netstandard contract output under Windows Defender. -->
    <BuildInParallel>false</BuildInParallel>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Game.Contracts\Game.Contracts.csproj"
                      AdditionalProperties="LumberjacksClientTarget=true" />
  </ItemGroup>
</Project>
