<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Lumberjacks.Companion</AssemblyName>
    <RootNamespace>Lumberjacks.Companion</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="workbench-checklist.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Game.Companion.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Cross-repo boundary (comfy-quest owns Comfy.Quest.Contracts): the compiled assembly only
         (ExcludeAssets="contentFiles" — Companion needs ExperienceContract/QuestPackContent/etc,
         not the mod's single-DLL ModGlue source). -->
    <PackageReference Include="Comfy.Quest.Contracts" ExcludeAssets="contentFiles" />
  </ItemGroup>
</Project>
