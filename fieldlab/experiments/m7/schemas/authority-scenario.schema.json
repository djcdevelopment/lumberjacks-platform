{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authority-scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "scenario_id", "seed", "plane", "duration_seconds", "actors", "objects", "policy", "driver", "stop_rules"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "plane": { "type": "string", "enum": ["relevance", "replication", "ownership", "motion", "rpc"] },
    "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "actors": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "trajectory"], "properties": { "id": { "type": "string" }, "trajectory": { "type": "string" } } } },
    "objects": { "type": "object", "required": ["generator", "count", "classes"], "properties": { "generator": { "type": "string" }, "count": { "type": "integer", "minimum": 0 }, "classes": { "type": "array", "items": { "type": "string" } } } },
    "policy": { "type": "object", "required": ["name", "near_meters", "outer_meters", "mid_hz"], "properties": { "name": { "type": "string" }, "near_meters": { "type": "number" }, "outer_meters": { "type": "number" }, "mid_hz": { "type": "number" } } },
    "driver": { "type": "string", "enum": ["pure", "gateway", "gateway_durable", "gateway_udp", "replay", "local_valheim_shadow", "local_valheim_strict", "p7_shadow", "p7_canary"] },
    "stop_rules": { "type": "array", "items": { "type": "string" } },
    "parameters": { "type": "object" }
  }
}
